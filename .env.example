# Firebase Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# UID del usuario (emprendedora) que administra el negocio.
# Se usa en la vista pública para leer sus menús publicados.
VITE_OWNER_ID=

# WhatsApp de la emprendedora, formato internacional sin + ni espacios
VITE_WHATSAPP_NUMBER=573001234567

# Cloudinary: solo valores públicos. El upload preset debe ser UNSIGNED.
# Nunca pongas aquí un API Secret (ni CLOUDINARY_API_SECRET).
# En Cloudinary activa "Overwrite" en el preset para reemplazar PDFs.
# Además, en Settings > Security activa "Allow delivery of PDF and ZIP files"
# para que los planes Free puedan abrir los PDFs subidos.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Opcional: preset unsigned independiente para imágenes (logo, platos, eventos).
# Si se deja vacío se usa VITE_CLOUDINARY_UPLOAD_PRESET.
VITE_CLOUDINARY_IMAGE_UPLOAD_PRESET=

# Opcional: endpoint propio (serverless/backend) que elimina assets en Cloudinary.
# Debe aceptar POST JSON { publicId, resourceType } y ejecutar la Admin API
# con el API Secret en el servidor. Nunca exponer el secreto en el frontend.
VITE_CLOUDINARY_DELETE_URL=
