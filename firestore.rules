rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
    }

    /* La emprendedora solo puede leer su propio perfil. */
    match /users/{uid} {
      allow read, write: if isSignedIn() &&
        request.auth.uid == uid;
    }

    /*
     * Los menús son públicos: el cliente necesita leerlos
     * sin iniciar sesión. Las escrituras sí quedan protegidas.
     */
    match /dailyMenus/{menuId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.ownerId ==
          request.auth.uid;

      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId ==
          request.auth.uid;

      allow delete: if isOwner();
    }

    /*
     * Cualquier cliente puede crear una reserva, pero solo
     * la emprendedora dueña puede leerla o modificarla.
     */
    match /bookings/{bookingId} {
      allow create: if request.resource.data.ownerId is string &&
        request.resource.data.ownerId.size() > 0;

      allow read, update, delete: if isOwner();
    }
  }
}
